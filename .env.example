# ─── Required (all environments) ───────────────────────────────────────────
AUTH_SECRET="your-random-secret-at-least-32-chars"
NEXTAUTH_URL=http://localhost:3000

# Local/dev database
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Daily auto-present cron (10:00 AM Asia/Kolkata)
CRON_SECRET="your-cron-secret"
AUTO_PRESENT_TIMEZONE=Asia/Kolkata
AUTO_PRESENT_HOUR=10

# ─── Local development only (demo data) ──────────────────────────────────────
# Run: npm run db:push && npm run db:seed
# Creates demo managers, employees, and sample attendance.

# ─── Production bootstrap (master admin only) ────────────────────────────────
# 1. Point DATABASE_URL at your production Neon/Postgres database
# 2. Set the values below (use strong secrets in production)
# 3. Run: npm run db:push && npm run db:bootstrap
#
# Do NOT run npm run db:seed in production — it inserts dummy demo data.
#
# MASTER_ADMIN_PHONE=9876543210
# MASTER_ADMIN_PASSWORD=your-strong-password-here
# ORGANIZATION_NAME=Zrutam Attendance
# MASTER_ADMIN_NAME=Master Admin
